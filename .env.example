# Copy to .env (or run scripts/init-env.sh to generate random values). Never commit .env.
# JWT_SECRET must be at least 32 bytes; demo passwords at least 12 characters.
JWT_SECRET=
DB_PASSWORD=
DEMO_OPERATOR_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=
DEMO_SERVICE_PASSWORD=

# Optional: use a local PostgreSQL server instead of the built-in H2 file database.
# scripts/run-local.sh and IntelliJ (VM option -Dspring.profiles.active=demo) then use these.
#CONFIG_PROFILES=demo
#DB_URL=jdbc:postgresql://localhost:5432/config
#DB_USER=postgres
#DB_PASSWORD=
#LOG_FORMAT=
#FAULTS_ENABLED=true
