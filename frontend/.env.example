# Copy to .env.local and adjust. No secrets belong here: everything VITE_* is bundled into the browser code.

# Where the dev/preview proxy forwards /api and /actuator (the config server).
VITE_PROXY_TARGET=http://localhost:8080
# Where the dev/preview proxy forwards /booking-api (the demo booking service).
VITE_BOOKING_PROXY_TARGET=http://localhost:8081

# Optional absolute API origin used by the browser instead of the same-origin proxy, e.g.
# https://config.example.internal . Leave empty unless the backend (or a reverse proxy in front of it)
# allows this site's origin via CORS - the config server itself does not configure CORS.
VITE_API_BASE_URL=
VITE_BOOKING_BASE_URL=
